# Copy this file to .env and fill in real values. Never commit .env.

# --- used by themes.py (news -> theme research LLM call) -------------------
OPENAI_API_KEY=
# Optional, defaults to gpt-4o-mini if unset:
# OPENAI_MODEL=gpt-4o-mini

# --- used by trader.py, and by themes.py (via trader.connect for tradability checks) ---
GROWW_API_KEY=
GROWW_API_SECRET=

# --- used by trader.py only: controls paper vs live trading -----------------
# Leave blank/unset for PAPER mode (default, no real orders).
# Set to exactly YES_I_UNDERSTAND to allow LIVE orders. Do not set this lightly.
LIVE_CONFIRM=
